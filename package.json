{
  "name": "principal-ai-architect-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node tools/build-route-styles.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "npm run build && npm run export:pages",
    "compact:graphs": "node tools/build-compact-project-graphs.mjs",
    "export:pages": "node tools/export-github-pages.mjs",
    "refresh:graphs": "node tools/build-project-graphs.mjs",
    "refresh:player-records": "node tools/refresh-project-player-records.mjs",
    "refresh:credential-badges": "node tools/refresh-credential-badges.mjs",
    "motion:studio": "remotion studio remotion/index.ts",
    "motion:render": "remotion still remotion/index.ts OperatingArc public/motion/operating-arc-poster.jpg --frame=149 --image-format=jpeg --jpeg-quality=88 --overwrite && remotion render remotion/index.ts OperatingArc public/motion/operating-arc.mp4 --codec=h264 --crf=26 --muted --overwrite",
    "motion:verify": "node --test tests/motion-artifact.test.mjs",
    "preview:pages": "node tools/serve-pages.mjs",
    "qa:viewports": "node tools/viewport-audit.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "d3-force": "^3.0.0",
    "motion": "^12.42.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@remotion/cli": "4.0.520",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6",
    "react-server-dom-webpack": "19.2.8",
    "remotion": "4.0.520",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.143.1"
  },
  "overrides": {
    "vinext@0.0.50": {
      "image-size": "2.0.3"
    },
    "next": {
      "sharp": "0.35.4"
    },
    "postcss": {
      ".": "8.5.23",
      "nanoid": "3.3.18"
    },
    "baseline-browser-mapping@2": "2.11.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "browserslist@4": "4.28.7",
    "fast-uri@3": "3.1.8",
    "fflate@0.7": "0.7.5",
    "js-yaml@4": "4.3.2"
  },
  "type": "module",
  "description": "The public systems portfolio of Principal AI Architect Madison Hope Steiner, grounded in the GitHub histories of mh0pe and awsmadi.",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
