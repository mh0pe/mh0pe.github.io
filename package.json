{
  "name": "principal-ai-architect-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "npm run build && npm run export:pages",
    "compact:graphs": "node tools/build-compact-project-graphs.mjs",
    "export:pages": "node tools/export-github-pages.mjs",
    "refresh:graphs": "node tools/build-project-graphs.mjs",
    "refresh:player-records": "node tools/refresh-project-player-records.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "d3-force": "^3.0.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
